# Скопируйте этот файл в .env и заполните нужное. Все поля необязательны.

# GitHub-токен (без него лимит 60 запросов/час; нужен для приватных репозиториев).
# Создать: GitHub -> Settings -> Developer settings -> Personal access tokens (read-only достаточно).
GITHUB_TOKEN=

# --- LLM (любой OpenAI-совместимый API). Без ключа проект работает без LLM. ---
# DeepSeek (по умолчанию):
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
# Локальный Ollama (бесплатно, без интернета для LLM):
#   LLM_API_KEY=ollama
#   LLM_BASE_URL=http://localhost:11434/v1
#   LLM_MODEL=qwen2.5:7b

# --- Векторная БД ---
CHROMA_DIR=.chroma
# default = all-MiniLM-L6-v2 (скачивается при первом запуске), hash = лёгкий оффлайн-вариант для отладки
EMBEDDER=default
